{
  "name": "tough-mudder-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "TZ=America/Los_Angeles vitest run",
